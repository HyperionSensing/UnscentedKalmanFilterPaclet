Cell[BoxData[{
 RowBox[{
  RowBox[{"cl2dAccelVariance", " ", "=", " ", "0.01"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cl2dGyroVariance", " ", "=", " ", "0.0001"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "takes", " ", "measurements", " ", "from", " ", "all", " ", 
     "the", " ", "sensors"}], ",", " ", 
    RowBox[{"adds", " ", "noise"}], ",", " ", 
    RowBox[{"and", " ", "appends", " ", 
     RowBox[{"timestamps", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cl2dMakeMeasurements", "[", 
     RowBox[{"sensorNames_", ",", "noiseVariance_"}], "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"times", " ", "=", " ", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"Sequence", "@@", "cl2dTimeRange"}], ",", " ", "0.01"}], 
          "]"}]}], ",", " ", "\[ScriptCapitalD]", ",", " ", "noisyReadings"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", " ", "=", " ", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Sqrt", "[", "noiseVariance", "]"}]}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Readings", " ", "structured", " ", "as", " ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"time_", "1"}], ":", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"sensor_", "1"}], ",", " ", 
              RowBox[{"sensor_", "2"}]}], "}"}]}], ",", "  ", "..."}], " ", 
          "}"}]}], " ", "*)"}], ";", "\[IndentingNewLine]", 
       RowBox[{"noisyReadings", "=", " ", 
        RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"cl2dModelSim", "[", "sensor", "]"}], "[", "times", 
             "]"}], " ", "+", " ", 
            RowBox[{"RandomVariate", "[", 
             RowBox[{"\[ScriptCapitalD]", ",", " ", 
              RowBox[{"Length", "[", "times", "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"sensor", ",", " ", "sensorNames"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"times", ",", "noisyReadings"}], "}"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cl2dAccel1Measurements", " ", "=", " ", 
    RowBox[{"cl2dMakeMeasurements", "[", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\"\<sensor1.pa[1]\>\"", ",", "\"\<sensor1.pa[2]\>\"", ",", 
        "\"\<sensor1.pa[3]\>\""}], "}"}], ",", "\[IndentingNewLine]", " ", 
      "cl2dAccelVariance"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cl2dAccel2Measurements", " ", "=", " ", 
    RowBox[{"cl2dMakeMeasurements", "[", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\"\<sensor2.pa[1]\>\"", ",", "\"\<sensor2.pa[2]\>\"", ",", 
        "\"\<sensor2.pa[3]\>\""}], "}"}], ",", "\[IndentingNewLine]", " ", 
      "cl2dAccelVariance"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cl2dGyroMeasurements", " ", "=", " ", 
    RowBox[{"cl2dMakeMeasurements", "[", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\"\<sensor1.w[1]\>\"", ",", "\"\<sensor1.w[2]\>\"", ",", 
        "\"\<sensor1.w[3]\>\""}], "}"}], ",", "\[IndentingNewLine]", " ", 
      "cl2dGyroVariance"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cl2dMeasurements", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#1", ",", " ", 
        RowBox[{
         RowBox[{"#2", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}], "]"}], "]"}], " ", "~", "Join", 
         "~", " ", 
         RowBox[{"#3", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}], "]"}], "]"}], " ", "~", "Join", 
         "~", " ", 
         RowBox[{"#4", "[", 
          RowBox[{"[", 
           RowBox[{"{", "2", "}"}], "]"}], "]"}]}]}], "}"}], "&"}], ",", " ", 
     
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cl2dAccel1Measurements", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{"(*", "time", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"cl2dAccel1Measurements", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"cl2dAccel2Measurements", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"cl2dGyroMeasurements", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
