Cell["\<\
Then run a number of EM iterations and plot the final output:\
\>", "Text",
 CellChangeTimes->{{3.937311630819045*^9, 3.937311639879738*^9}},
 CellID->512996876,ExpressionUUID->"d6facaab-bda6-4736-8dd6-6237c56b8bbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"emIterations", " ", "=", " ", "100"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"initalState", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"0.001", ",", " ", "4"}], "}"}], "]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "}"}], ",", " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Run", " ", "a", " ", "certain", " ", "number", " ", "of", " ", "EM", " ",
      "iterations", " ", "to", " ", "refine", " ", "the", " ", "state"}], " ",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shmSystem", "=", 
     RowBox[{"Nest", "[", 
      RowBox[{
       RowBox[{"Composition", "[", "\[IndentingNewLine]", 
        RowBox[{
        "UKFParameterMaximization", ",", "\[IndentingNewLine]", "UKFSmoother",
          ",", "\[IndentingNewLine]", 
         RowBox[{"UKFFilter", "[", 
          RowBox[{"initalState", ",", "  ", "shmMeasurements"}], "]"}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "shmSystem",
        ",", "\[IndentingNewLine]", "emIterations"}], "\[IndentingNewLine]", 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"EchoLabel", "[", "\"\<Final Parameters\>\"", "]"}], "@", " ", 
     RowBox[{"shmSystem", "[", "\"\<Parameters\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Do", " ", "a", " ", "final", " ", "smoothing", " ", "and", " ", "show", 
      " ", "the", " ", 
      RowBox[{"results", "."}]}], "*)"}], "\[IndentingNewLine]", 
    InterpretationBox[
     DynamicModuleBox[{Typeset`open = True}, 
      TemplateBox[{"Expression", 
        RowBox[{"Module", "[", 
          DynamicBox[
           FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], "]"}], 
        GridBox[{{
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["2800", "IconizedItem"]}]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
         "Column", 
         GridBoxItemSize -> {
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
        Dynamic[Typeset`open]},
       "IconizedObject"]],
     Module[{$CellContext`results = UnscentedKalmanFilter`UKFSmoother[
         UnscentedKalmanFilter`UKFFilter[$CellContext`initalState, \
$CellContext`shmMeasurements][$CellContext`shmSystem]], $CellContext`h = \
$CellContext`shmSystem[
        "MeasurementModel"], $CellContext`params = $CellContext`shmSystem[
        "Parameters"], $CellContext`convertedSamples}, \
$CellContext`convertedSamples = Map[$CellContext`covarianceToAround, 
         $CellContext`results["SmoothedStates"]]; GraphicsRow[{
         ListLinePlot[{
           Part[$CellContext`convertedSamples, All, 2, 1], 
           $CellContext`shmSim["mass1.s"][
            Part[$CellContext`results, "SmoothedStates", All, 1]]}, 
          Sequence[
          PlotStyle -> {Automatic, Dashed}, IntervalMarkers -> "Bands", 
           PlotLabel -> "Mass Position"]], 
         ListLinePlot[{
           ReplaceAll[
            Flatten[
             Map[$CellContext`h, 
              
              Part[$CellContext`convertedSamples, All, 
               2]]], $CellContext`params], 
           $CellContext`shmSim["mass1.a"][
            Part[$CellContext`results, "SmoothedStates", All, 1]]}, 
          Sequence[
          PlotStyle -> {Automatic, Dashed}, IntervalMarkers -> "Bands", 
           PlotLabel -> "Mass Acceleration"]]}]],
     SelectWithContents->True,
     Selectable->False]}]}], "\[IndentingNewLine]", "]"}]], "Input",
