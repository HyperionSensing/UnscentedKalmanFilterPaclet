    RowBox[{"(*", "State", "*)"}], "\[IndentingNewLine]", "1", ",", " ", 
    RowBox[{"(*", "\[CapitalDelta]t", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"<|", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"\"\<ProcessModel\>\"", " ", "->", " ", 
       RowBox[{"(", 
