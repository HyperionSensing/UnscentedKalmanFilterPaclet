           RowBox[{"{", 
            RowBox[{"2.", ",", "5."}], "}"}]}], "}"}]}], "}"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "h", ",", "h\[Sigma]s", ",", " ", "h\[Mu]", ",", 
