 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Both", " ", "elements", " ", "of", " ", "the", " ", "state", " ", 
    "contribute", " ", "equally", " ", "to", " ", "the", " ", "uncertainty", 
    " ", "in", " ", "the", " ", "measurement"}], " ", "*)"}], 
