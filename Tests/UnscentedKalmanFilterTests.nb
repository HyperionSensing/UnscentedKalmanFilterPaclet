Cell[CellGroupData[{

Cell["Warning: Sensitivity to Initial Variance", "Subsubsection",
 CellChangeTimes->{{3.941201516541376*^9, 3.94120156144138*^9}},
 CellID->512777036,ExpressionUUID->"db64d800-8b23-4c17-a11a-c4a33a38677f"],

Cell["\<\
It\[CloseCurlyQuote]s tempting to just use some factor of the identity matrix \
for the initial state variance.  Intuitively, you might expect this means the \
kalman filter will lock on to the correct value during the forward pass \
(correct) and then the kalman smoother will extend this back all the way to \
the start.  Surprisingly for me, this last part is incorrect.  In this case, \
it\[CloseCurlyQuote]s easy to have the smoothed results blow up at the start:\
\
\>", "Text",
 CellChangeTimes->{{3.9412015642799253`*^9, 3.9412016614090843`*^9}, {
  3.941201706964622*^9, 3.9412017265313683`*^9}, {3.941201796874126*^9, 
  3.941201797107526*^9}},
 CellID->449298204,ExpressionUUID->"46133cec-f5fc-484d-abe9-4ef0aa2024a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "results", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"results", " ", "=", 
      RowBox[{
       RowBox[{"Composition", "[", "\[IndentingNewLine]", 
        RowBox[{"UKFSmoother", ",", "\[IndentingNewLine]", 
         RowBox[{"UKFFilter", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "*", "0.2"}], ",", 
               RowBox[{"0.003", "*", "0.2"}]}], "}"}], ",", " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}], "]"}]}], "}"}], ",", " ", 
           "popGrowthMeasurements"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
       "@", "popGrowthSystem"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<Data\>\"", "->", 
         RowBox[{"popGrowthData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Filter\>\"", "->", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"stateToUncertainValue", ",", 
            RowBox[{"results", "[", 
             RowBox[{"[", "\"\<FilteredStates\>\"", "]"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Smoother\>\"", "->", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"stateToUncertainValue", ",", 
            RowBox[{"results", "[", 
             RowBox[{"[", "\"\<SmoothedStates\>\"", "]"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "|>"}], ",", " ", 
      RowBox[{"IntervalMarkers", "->", "\"\<Bands\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"All", ",", "All"}], "}"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.935535585091873*^9, 3.935535600876897*^9}, {
