Cell[CellGroupData[{

Cell["UKFParameterMaximization", "Subsubsection",
 CellChangeTimes->{{3.937088420581448*^9, 3.93708842651208*^9}, 
   3.9374846381516027`*^9},
 CellID->267727225,ExpressionUUID->"6d9e2e7d-11ad-410d-bcaa-83e82892a79c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"popGrowthSystemParameterized", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"{", "y_", "}"}], ",", "\[CapitalDelta]t_"}], "]"}], " ", ":=",
        " ", 
       RowBox[{"N", "@", 
        RowBox[{"{", 
         RowBox[{"y", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[FormalK]", " ", "\[CapitalDelta]t"}], "]"}]}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"{", "y_", "}"}], "]"}], " ", ":=", " ", 
       RowBox[{"{", "y", "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"\"\<ProcessModel\>\"", " ", "->", "f"}], ",", " ", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"\"\<MeasurementModel\>\"", " ", "->", " ", "h"}], ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<ProcessNoise\>\"", "->", 
         RowBox[{"0.000000001", 
          RowBox[{"IdentityMatrix", "[", "1", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<MeasurementNoise\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"{", 
           SuperscriptBox["0.2", "2"], "}"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Parameters\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"\[FormalK]", " ", "->", " ", "0.003"}], "}"}]}]}], 
       "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.9411955567624598`*^9, {3.941204034757268*^9, 3.941204102159156*^9}, {
   3.941208707569091*^9, 3.941208712955261*^9}},
 CellLabel->"In[166]:=",
 CellID->2008587058,ExpressionUUID->"65e66a5e-9726-44fc-85af-c94254dbca03"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "results", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", " ", "=", 
     RowBox[{
      RowBox[{"Composition", "[", "\[IndentingNewLine]", 
       RowBox[{"UKFSmoother", ",", "\[IndentingNewLine]", 
        RowBox[{"UKFFilter", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"1", "*", "0.2"}], "}"}], ",", " ", 
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"{", 
              SuperscriptBox["1", "2"], "}"}], "]"}]}], "}"}], ",", " ", 
          "popGrowthMeasurements"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
      "@", "popGrowthSystemParameterized"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<Data\>\"", "->", 
         RowBox[{"popGrowthData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Filter\>\"", "->", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"stateToUncertainValue", ",", 
            RowBox[{"results", "[", 
             RowBox[{"[", "\"\<FilteredStates\>\"", "]"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Smoother\>\"", "->", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"stateToUncertainValue", ",", 
            RowBox[{"results", "[", 
             RowBox[{"[", "\"\<SmoothedStates\>\"", "]"}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "|>"}], ",", " ", 
      RowBox[{"IntervalMarkers", "->", "\"\<Bands\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"All", ",", "All"}], "}"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.94120411748372*^9, 3.941204128680664*^9}},
 CellLabel->"In[167]:=",
 CellID->120353712,ExpressionUUID->"ed0b05b0-630e-4e83-b47d-0ec6d44271a8"],

