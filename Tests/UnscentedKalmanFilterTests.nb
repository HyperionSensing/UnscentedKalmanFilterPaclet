 RowBox[{
  RowBox[{
   RowBox[{"cl2dAccel1Measurements", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"times", " ", "=", " ", 
        RowBox[{"Range", "[", 
         RowBox[{
