Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"covarianceToAround", "::", "usage"}], " ", "=", 
   "\"\<covarianceToAround[state] converts our usual kalman \
time-state-covariance tuple into a time-around pair. This currently does not \
include any inter-state covariance. Could use VectorAround?\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"covarianceToAround", "[", 
   RowBox[{"state_", ",", " ", 
    RowBox[{"x\[Sigma]_", ":", "3"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"state", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Around", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"x\[Sigma]", " ", 
          RowBox[{"Sqrt", "[", "#2", "]"}]}]}], "]"}], "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"state", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"Diagonal", "[", 
         RowBox[{"state", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
   "}"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.93731166924286*^9, 3.937311846400721*^9}, {
  3.9373119001682777`*^9, 3.937311920979803*^9}},
 CellLabel->"In[71]:=",
 CellID->46523416,ExpressionUUID->"15591a41-ae06-4596-ba2c-430e324902a5"]
}, Open  ]],

