Cell[BoxData[
 RowBox[{
  RowBox[{"makeSigmaPointsFromTransition2", "[", 
   RowBox[{"{", 
    RowBox[{"times_", ",", " ", "means_", ",", " ", "covars_"}], "}"}], "]"}],
   " ", ":=", " ", 
  RowBox[{"UKFSigmaPoints", "[", 
   RowBox[{
    RowBox[{"{", "\n", "\t\t", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"means", ",", " ", "1"}], "]"}], ",", "\t", "\n", "\t\t", 
      RowBox[{"d", "=", 
       RowBox[{"makeHermitian2", "@", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"covars", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"covars", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", "\t\t\t", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"covars", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "\[Transpose]"}], ",", " ", 
             RowBox[{"covars", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "\n", "\t\t", "}"}], 
         "]"}]}]}]}], "\n", "\t", "}"}], ",", " ", "\n", "\t", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "4"}], "]"}], ",", "\n", "\t", "1"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"THis", " ", "is", " ", "to", " ", "avoid", " ", "negative", " ", 
      RowBox[{"weights", "!"}], " ", "That", " ", 
      RowBox[{"doesn", "'"}], "t", " ", "play", " ", "well", " ", "with", " ",
       "our", " ", "extension", " ", "to", " ", "nonlinear", " ", 
      RowBox[{"maximization", ".", " ", "I"}], " ", 
      RowBox[{"don", "'"}], "t", " ", "think", " ", "this", " ", "will", " ", 
      "make", " ", "a", " ", "big", " ", "difference"}], ",", " ", 
     RowBox[{
     "but", " ", "we", " ", "might", " ", "be", " ", "able", " ", "to", " ", 
      "work", " ", "around", " ", "it", " ", "when", " ", "moving", " ", "to",
       " ", 
      RowBox[{"c", "."}]}]}], "*)"}], "\n", "\t", "]"}]}]], "Input",
