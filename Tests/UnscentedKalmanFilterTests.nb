    RowBox[{"\[Lambda]", " ", "=", " ", "0.003"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Sigma]", "=", "0.2"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[ScriptCapitalD]error", "=", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "\[Sigma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"popGrowthData", " ", "=", " ", 
     RowBox[{"Table", "[", 
