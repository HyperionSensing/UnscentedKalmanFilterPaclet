Cell[TextData[StyleBox["Filtering & Smoothing", "Subsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.9355318085726357`*^9, 3.935531810127133*^9}, {
  3.935750598333905*^9, 3.935750601029179*^9}},
 CellID->236754742,ExpressionUUID->"6747c46d-4144-43e6-babe-e482a01ad7bc"],

Cell[TextData[{
 "For a test scenario,  we model population growth. I picked this because it \
seemed like an easy non-linear scenario to model.  It satisfies the simple \
ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "y"}], 
     RowBox[{"\[PartialD]", "t"}]], " ", "=", " ", 
    RowBox[{"v", " ", "y"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "45ca5fbf-1ad0-4051-9f16-5b21dec4f2d3"],
 "."
}], "Text",
 CellChangeTimes->{{3.9411977410687532`*^9, 3.941197813573579*^9}},
 CellID->674584194,ExpressionUUID->"5c26b66a-6586-439c-a321-4a34f147ec5f"],

