  "\[RightAssociation]"}]], "Output",
 InitializationCell->True,
 CellChangeTimes->{
  3.937311302328627*^9, 3.937312601874448*^9, {3.937312687591117*^9, 
   3.937312715137672*^9}, 3.937312779874937*^9, 3.93739973569985*^9, 
   3.9373997752122183`*^9, 3.9373998237159452`*^9, 3.937399854648963*^9, 
   3.937489516089308*^9, 3.937489663497939*^9, {3.937752505151881*^9, 
