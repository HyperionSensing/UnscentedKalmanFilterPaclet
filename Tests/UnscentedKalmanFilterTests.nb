         RowBox[{
          RowBox[{"\[FormalB]", " ", "x"}], " ", "+", " ", 
          RowBox[{"\[FormalA]", " ", "y"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[FormalA]", ",", " ", "\[FormalB]"}], "}"}], ",", " ", 
       RowBox[{"{", 
