          RowBox[{"{", 
           RowBox[{"coords", ",", " ", "\[CapitalDelta]t"}], "}"}], 
          "\[Function]", " ", 
          RowBox[{"coords", " ", "+", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], "\[CapitalDelta]t"}]}]}], 
         ")"}]}], ",", " ", 
       RowBox[{"(*", " ", "f", " ", "*)"}], "\[IndentingNewLine]", " ", 
       RowBox[{"\"\<MeasurementModel\>\"", " ", "->", " ", 
        RowBox[{"(", 
