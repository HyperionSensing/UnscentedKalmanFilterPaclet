Cell[TextData[{
 "For a test scenario,  we model population growth. I picked this because it \
seemed like an easy non-linear scenario to model.  It satisfies the simple \
ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "y"}], 
     RowBox[{"\[PartialD]", "t"}]], " ", "=", " ", 
    RowBox[{"v", " ", "y"}]}], TraditionalForm]],ExpressionUUID->
  "86620294-2149-4dea-ba64-d4c9952413c3"],
 "."
}], "Text",
 CellChangeTimes->{{3.9411977410687532`*^9, 3.941197813573579*^9}},
 CellID->674584194,ExpressionUUID->"ff24fcb8-5f90-46d2-a2a6-679203220234"],

