       RowBox[{"{", "22", "}"}]}], "}"}], ",", " ", 
     RowBox[{"(*", " ", "Measurement", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"\"\<ProcessModel\>\"", " ", "->", " ", 
        RowBox[{"(", 
