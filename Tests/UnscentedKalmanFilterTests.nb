Cell[BoxData[
 RowBox[{"cl2dSystem", " ", "=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"lTrue", " ", "=", " ", "1"}], ",", " ", "lGuess", ",", " ", 
      "f", ",", "h", ",", " ", 
      RowBox[{"\[Sigma]2a", " ", "=", " ", "cl2dAccelVariance"}], ",", " ", 
      RowBox[{"\[Sigma]2g", " ", "=", " ", "cl2dGyroVariance"}]}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lGuess", " ", "=", " ", 
      RowBox[{"0.75", " ", "lTrue"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{
