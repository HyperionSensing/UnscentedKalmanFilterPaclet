Cell[BoxData[
 RowBox[{
  RowBox[{"popGrowthSystem", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y_", ",", "v_"}], "}"}], ",", "\[CapitalDelta]t_"}], "]"}],
        " ", ":=", " ", 
