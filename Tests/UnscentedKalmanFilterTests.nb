Cell["\<\
How does our smoother do at smoothing this data?  It depends on the \
\[FormalK] parameter that we use to define the spring constant. The code \
below allows you to use an initial starting guess and then use EM to improve \
it.  Start with the system definition:\
\>", "Text",
 CellChangeTimes->{{3.935758515257525*^9, 3.93575852781558*^9}, {
  3.93575857119413*^9, 3.9357585715906677`*^9}, {3.937310331432255*^9, 
  3.937310343462605*^9}, {3.9373104347011433`*^9, 3.937310437996484*^9}, {
  3.937310705385771*^9, 3.937310730196189*^9}, {3.9373116255474052`*^9, 
  3.93731162958867*^9}},
 CellID->1065906387,ExpressionUUID->"e07d674e-096a-437a-8070-28b20c1abc5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shmSystem", " ", "=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kTrue", " ", "=", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "2"]}], ",", " ", "kGuess", ",", " ", 
      "f", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kGuess", " ", "=", " ", 
      RowBox[{"0.5", " ", "kTrue"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1_", ",", "v1_"}], "}"}], ",", "\[CapitalDelta]t_"}], 
       "]"}], ":=", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"v2", " ", "=", " ", 
          RowBox[{"v1", "-", " ", 
           RowBox[{"\[FormalK]", " ", "x1", " ", "\[CapitalDelta]t"}]}]}], 
         "}"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x1", " ", "+", " ", 
           RowBox[{"v2", " ", "\[CapitalDelta]t"}]}], ",", "  ", "v2"}], 
         "}"}]}], " ", "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"{", 
        RowBox[{"x_", ",", "v_"}], "}"}], "]"}], ":=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", " ", "\[FormalK]"}], " ", "x"}], "}"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<ProcessModel\>\"", "->", "f"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<MeasurementModel\>\"", "->", "h"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<ProcessNoise\>\"", "->", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"0.0001", ",", "0.01"}], "}"}], "]"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<MeasurementNoise\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"{", "shmVariance", "}"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Parameters\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\[FormalK]", "->", "kGuess"}], "}"}]}]}], 
      "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.937310735352833*^9, 3.9373107991251707`*^9}, {
   3.93731085194707*^9, 3.937310873435945*^9}, 3.9373112744385138`*^9, 
   3.937752527898725*^9, {3.937752567321714*^9, 3.937752568026376*^9}},
 CellLabel->"In[80]:=",
 CellID->1121492537,ExpressionUUID->"0a57b8dc-aa65-4936-aaf1-ae3e90a0d9a8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ProcessModel\"\>", "\[Rule]", "f$52991"}], ",", 
   RowBox[{"\<\"MeasurementModel\"\>", "\[Rule]", "h$52991"}], ",", 
   RowBox[{"\<\"ProcessNoise\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.0001`", ",", "0.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "0.01`"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"MeasurementNoise\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", "5", "}"}], "}"}]}], ",", 
