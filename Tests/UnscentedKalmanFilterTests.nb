      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "x"}], " ", "+", " ", 
         RowBox[{"5", "y"}]}], ",", " ", 
        RowBox[{
         RowBox[{"5", "x"}], " ", "+", " ", 
         RowBox[{"2", "y"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#", ",", " ", 
           RowBox[{
            RowBox[{"f", "[", "#", "]"}], " ", "+", " ", 
            RowBox[{"RandomVariate", "[", 
             RowBox[{"BinormalDistribution", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.02", ",", " ", "0.02"}], "}"}], ",", " ", "0"}], 
              "]"}], "]"}]}]}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"100", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"UnscentedKalmanFilter`Private`MultiNonlinearFitModelFit", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"DiagonalMatrix", "[", 
